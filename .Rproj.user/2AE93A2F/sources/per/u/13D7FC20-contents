  # -------------------------------------------------------
  
  pop = list(
          pop_censo = read_xlsx('./1. Dados Municipais/População por Municípios - Censo 2010 e 2022.xlsx',
                                skip = 6)[-5571,] %>% 
                      clean_names() %>% 
                      select(cod, municipio, x2010, x2022), 
          
          pop_estim = read_xlsx('./1. Dados Municipais/População Estimada por Municípios - 2001-2021 (exceto Censos).xlsx',
                                skip = 3)[-5571,] %>% 
                      clean_names() %>% 
                      select(cod, contains('x'))
        ) %>% 
        reduce(left_join, by = c('cod')) %>%
        mutate(across(contains('x'), as.numeric)) %>% 
        pivot_longer(cols = x2010:x2021, names_to = 'ano', values_to = 'pop') %>% 
        mutate(ano = str_remove(ano, 'x')) %>% 
        arrange(municipio, ano)
  
  
  base_final %>% 
    filter(ti == 1) %>%
    summarise(hom_tot_sum = sum(hom_tot, na.rm = T),
              pop_sum = sum(pop), 
              .by = c(ano, ga2018)) %>%
    mutate(tx_hom_tot_sum = (hom_tot_sum / pop_sum) * 100000) %>%
    select(-c(hom_tot_sum, pop_sum)) %>% 
    pivot_wider(names_from = ga2018, values_from = tx_hom_tot_sum) %>% 
    mutate(razao = `1`/`0`,
           pct_change_0 = ((`0` / lag(`0`, 1)) - 1) * 100, 
           pct_change_1 = ((`1` / lag(`1`, 1)) - 1) * 100) 

  
  
  
  
  ## Paralelismo das Unidades
  
   left_join(base_final,
             terra_indigena %>% 
               st_drop_geometry() %>% 
               select(gid, municipio_, uf_sigla) %>%  
               separate_longer_delim(municipio_, delim = ",") %>% 
               separate_longer_delim(uf_sigla, delim = ",") %>%
               mutate(name_muni = str_c(municipio_, "/", uf_sigla), .keep = "unused", .after = gid) %>%
               mutate(across(everything(), str_trim),
                      gid = as.integer(gid)) %>% 
               filter(gid %in% c(308, 1453, 153)),
             by = 'name_muni') %>%
    mutate(gid = as.character(ifelse(is.na(gid), res_ou, gid))) %>% 
    filter(ti == 1, ano %in% c(2015, 2016, 2017)) %>% 
    mutate(res_ou = as.character(res_ou)) %>% 
    {ggplot(data = ., aes(x = ano, y = tx_hom_tot, group = name_muni, color = gid)) +
        geom_line() +
        scale_color_manual(values = c('grey', 'darkblue', 'lightgreen', 'red', 'yellow'))}
  
  
   
   
   
   
   
   
   
   
   
   
   
   base_final1 =  
   base_final %>% 
     mutate(
       res_ou_time2010 = ifelse(ano == 2010, res_ou, 0),
       res_ou_time2011 = ifelse(ano == 2011, res_ou, 0),
       res_ou_time2012 = ifelse(ano == 2012, res_ou, 0),
       res_ou_time2013 = ifelse(ano == 2013, res_ou, 0),
       res_ou_time2014 = ifelse(ano == 2014, res_ou, 0),
       res_ou_time2015 = ifelse(ano == 2015, res_ou, 0),
       res_ou_time2016 = ifelse(ano == 2016, res_ou, 0),
       res_ou_time2017 = ifelse(ano == 2017, res_ou, 0),
       # Exclude res_ou_time2018 to use it as the reference ano
       res_ou_time2019 = ifelse(ano == 2019, res_ou, 0),  # Treatment ano
       res_ou_time2020 = ifelse(ano == 2020, res_ou, 0),
       res_ou_time2021 = ifelse(ano == 2021, res_ou, 0),
       res_ou_time2022 = ifelse(ano == 2022, res_ou, 0)   # Post-treatment anos
     )
   
   
   pdata1 <- pdata.frame(base_final1, index = c("name_muni", "ano"))

   
   event_study_model <- plm(
     tx_hom_tot ~  res_ou_time2010 + res_ou_time2011 + res_ou_time2012 + 
       res_ou_time2013 + res_ou_time2014 + res_ou_time2015 + res_ou_time2016 + 
       res_ou_time2017 + res_ou_time2019 + res_ou_time2020 + res_ou_time2021 + 
       res_ou_time2022, #+ res_ou:pos2018 + ti:pos2018 + res_ou:ti:pos2018,
     data = pdata1, model = "within", effect = "twoways"
   )  
   
   
   # Step 4: Obtain cluster-robust standard errors
   event_study_robust_se <- coeftest(event_study_model, vcov = vcovHC(event_study_model, type = "HC1", cluster = "group"))
   
   # Display results
   print(event_study_robust_se)
   
   # Step 5: Extract coefficients for plotting
   library(broom)
   coef_df <- tidy(event_study_robust_se) %>%
     filter(grepl("res_ou_time", term))
   
   # Plotting the coefficients to visualize parallel trends
   library(ggplot2)
   ggplot(coef_df, aes(x = as.numeric(gsub("res_ou_time", "", term)), y = estimate)) +
     geom_point() +
     geom_errorbar(aes(ymin = estimate - 1.96 * std.error, ymax = estimate + 1.96 * std.error)) +
     labs(x = "Time Period", y = "Coefficient on res_ou",
          title = "Event Study for Parallel Trends Assumption") +
     geom_hline(yintercept = 0, linetype = "dashed", color = "red") +
     theme_minimal()
   