mutate(
res_ou_time2010 = ifelse(ano == 2010, res_ou, 0),
res_ou_time2011 = ifelse(ano == 2011, res_ou, 0),
res_ou_time2012 = ifelse(ano == 2012, res_ou, 0),
res_ou_time2013 = ifelse(ano == 2013, res_ou, 0),
res_ou_time2014 = ifelse(ano == 2014, res_ou, 0),
res_ou_time2015 = ifelse(ano == 2015, res_ou, 0),
res_ou_time2016 = ifelse(ano == 2016, res_ou, 0),
res_ou_time2017 = ifelse(ano == 2017, res_ou, 0),
# Exclude res_ou_time2018 to use it as the reference ano
res_ou_time2019 = ifelse(ano == 2019, res_ou, 0),  # Treatment ano
res_ou_time2020 = ifelse(ano == 2020, res_ou, 0),
res_ou_time2021 = ifelse(ano == 2021, res_ou, 0),
res_ou_time2022 = ifelse(ano == 2022, res_ou, 0)   # Post-treatment anos
)
pdata1 <- pdata.frame(base_final1, index = c("name_muni", "ano"))
event_study_model <- plm(
tx_hom_tot ~  res_ou_time2010 + res_ou_time2011 + res_ou_time2012 +
res_ou_time2013 + res_ou_time2014 + res_ou_time2015 + res_ou_time2016 +
res_ou_time2017 + res_ou_time2019 + res_ou_time2020 + res_ou_time2021 +
res_ou_time2022, #+ res_ou:pos2018 + ti:pos2018 + res_ou:ti:pos2018,
data = pdata1, model = "within", effect = "twoways"
)
# Step 4: Obtain cluster-robust standard errors
event_study_robust_se <- coeftest(event_study_model, vcov = vcovHC(event_study_model, type = "HC1", cluster = "group"))
# Step 5: Extract coefficients for plotting
library(broom)
coef_df <- tidy(event_study_robust_se) %>%
filter(grepl("res_ou_time", term))
View(coef_df)
